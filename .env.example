# =============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# =============================================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env y completa los valores reales
# 3. NUNCA commitees .env (está en .gitignore)
#
# Ver documentación completa en: docs/ENVIRONMENT_VARIABLES.md
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (Flask + Python)
# -----------------------------------------------------------------------------

# Token del bot de Telegram
# Obtén uno con @BotFather en Telegram: https://t.me/BotFather
# Comando: /newbot
# Ejemplo: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# API Key de OpenAI (GPT-3.5/GPT-4)
# Obtén una en: https://platform.openai.com/api-keys
# Ejemplo: sk-proj-ABC...XYZ
OPENAI_API_KEY=

# Otras opciones de LLM (opcional)
# CLAUDE_API_KEY=
# GEMINI_API_KEY=

# Entorno de Flask
# Valores: development, production
FLASK_ENV=development

# -----------------------------------------------------------------------------
# FRONTEND (Vite + React)
# -----------------------------------------------------------------------------

# ⚠️ IMPORTANTE: Variables con prefijo VITE_ se exponen en el navegador
# NO pongas secretos aquí (API keys, tokens privados, etc.)

# URL base del backend
# Desarrollo: http://localhost:5000
# Producción: https://tu-dominio.com
VITE_API_BASE_URL=http://localhost:5000

# URL del servidor WebSocket
# Generalmente la misma que VITE_API_BASE_URL
VITE_SOCKET_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# DOCKER
# -----------------------------------------------------------------------------

# Al usar docker-compose, estas variables se cargan automáticamente
# Si cambias variables VITE_*, debes reconstruir: docker compose build --no-cache
